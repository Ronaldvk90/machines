output VGA-1 resolution 1920x1200 position 0,0
output HDMI-A-1 resolution 1920x1200 position 1920,0

workspace 1 output VGA-1
workspace 2 output HDMI-A-1

exec swaymsg workspace number 1

 bar {
     position top

#     # When the status_command prints a new line to stdout, swaybar updates.
#     # The default just shows the current date and time.
#     #status_command while date +'%Y-%m-%d %X'; do sleep 1; done
     status_command while ~/.config/swaybar/swaybar_werkplaats.sh; do sleep 1; done
     colors {
         statusline #ffffff
         background #32323299
         inactive_workspace #32323200 #32323200 #5c5c5c
     }
}
