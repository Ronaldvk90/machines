{ pkgs, modulesPath, ... }:

{
  imports = [
    # Include the default incus configuration.
    "${modulesPath}/virtualisation/lxc-container.nix"
    # Include the container-specific autogenerated configuration.
    ./incus.nix
  ];
  
  boot.isContainer = true;
  nix.settings.sandbox = false;

  home-manager.users.ronald = import ../../home/ronald/server.nix;

############# SSH host key deployment ############
  age.secrets."ssh_host_ed25519_key" = {
    file = ./ssh_host_ed25519_key.age;
    path = "/etc/ssh/ssh_host_ed25519_key";
  };

  age.secrets."ssh_host_rsa_key" = {
    file = ./ssh_host_rsa_key.age;
    path = "/etc/ssh/ssh_host_rsa_key";
  };
##################################################

############# SSL cert for Nginx deployment ######
  age.secrets."zabbix_bttf_lan_key" = {
    file = ./zabbix_bttf_lan_key.age;
    owner = "nginx";
    group = "nginx";
  };

  age.secrets."zabbix_bttf_lan_crt" = {
    file = ./zabbix_bttf_lan_crt.age;
    owner = "nginx";
    group = "nginx";
  };
##################################################
  networking = {
    enableIPv6 = true;
    firewall.enable = true;
    dhcpcd.enable = false;
    useDHCP = false;
    useHostResolvConf = false;
  };

  systemd.network = {
    enable = true;
    networks."50-eth0" = {
      matchConfig.Name = "eth0";
      address = [
        "10.10.10.8/24"
        "fd42:4242:4242:1::8"  
      ];

      networkConfig = {
        Gateway = [
          "10.10.10.1"
          "fd42:4242:4242:1::1"
        ];

        DNS = [
          "10.10.10.1"
          "fd42:4242:4242:1::1"
        ];
      };
      
      linkConfig = {
        RequiredForOnline = "routable";
        MACAddress = "10:66:6a:5d:9e:df";
      };
    };
  };
  
  system.stateVersion = "26.05"; # Did you read the comment?
}